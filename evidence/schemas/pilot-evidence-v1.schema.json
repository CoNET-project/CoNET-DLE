{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conet:dle:pilot:evidence:v1",
  "title": "CoNET DLE 30-day pilot evidence schemas",
  "$ref": "#/$defs/EvidenceManifestV1",
  "$defs": {
    "OperatorDomainV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "operatorDomainId",
        "operatorLegalName",
        "hostId",
        "provider",
        "region",
        "networkAsn",
        "role",
        "billingRef"
      ],
      "properties": {
        "domainId": { "type": "string", "minLength": 1 },
        "operatorDomainId": { "type": "string", "minLength": 1 },
        "operatorLegalName": { "type": "string", "minLength": 1 },
        "hostId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "networkAsn": { "type": "string", "minLength": 1 },
        "role": { "enum": ["active", "standby"] },
        "billingRef": { "type": "string", "minLength": 1 }
      }
    },
    "PilotInventoryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "pilotId", "generatedAt", "domains"],
      "properties": {
        "schema": { "const": "PilotInventoryV1" },
        "pilotId": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "domains": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/OperatorDomainV1" }
        }
      }
    },
    "FailureScenarioV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "kind",
        "targetDomainIds",
        "durationMs",
        "parameters",
        "simulationOnly",
        "destructive"
      ],
      "properties": {
        "schema": { "const": "FailureScenarioV1" },
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "process-crash",
            "network-partition",
            "disk-corruption",
            "wal-corruption",
            "duplicate-message",
            "reorder-message",
            "stale-membership",
            "oracle-fault",
            "treasury-fault",
            "l1-reorg-simulation"
          ]
        },
        "targetDomainIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "durationMs": { "type": "integer", "minimum": 0 },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "simulationOnly": { "const": true },
        "destructive": { "const": false }
      }
    },
    "FailureSampleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sampleId",
        "pilotId",
        "scenarioId",
        "scenarioKind",
        "targetDomainIds",
        "startedAt",
        "endedAt",
        "outcome",
        "safetyInvariant",
        "observation",
        "simulated"
      ],
      "properties": {
        "schema": { "const": "FailureSampleV1" },
        "sampleId": { "type": "string", "minLength": 1 },
        "pilotId": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": "string", "minLength": 1 },
        "scenarioKind": { "$ref": "#/$defs/FailureScenarioV1/properties/kind" },
        "targetDomainIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["contained", "recovered", "safety-failure"] },
        "safetyInvariant": { "type": "string" },
        "observation": { "type": "string" },
        "simulated": { "type": "boolean" }
      }
    },
    "MeterSampleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sampleId",
        "pilotId",
        "domainId",
        "measuredAt",
        "metric",
        "value",
        "unit"
      ],
      "properties": {
        "schema": { "const": "MeterSampleV1" },
        "sampleId": { "type": "string", "minLength": 1 },
        "pilotId": { "type": "string", "minLength": 1 },
        "domainId": { "type": "string", "minLength": 1 },
        "measuredAt": { "type": "string", "format": "date-time" },
        "metric": {
          "enum": ["availability", "latency_ms", "requests", "bytes", "failovers"]
        },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "InvoiceLineV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domainId", "meterMetric", "quantity", "unitPrice", "amount"],
      "properties": {
        "domainId": { "type": "string", "minLength": 1 },
        "meterMetric": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number", "minimum": 0 },
        "unitPrice": { "type": "number", "minimum": 0 },
        "amount": { "type": "number", "minimum": 0 }
      }
    },
    "InvoiceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "invoiceId",
        "pilotId",
        "billingPeriodStart",
        "billingPeriodEnd",
        "currency",
        "lines",
        "subtotal",
        "sourceBillingRefs"
      ],
      "properties": {
        "schema": { "const": "InvoiceV1" },
        "invoiceId": { "type": "string", "minLength": 1 },
        "pilotId": { "type": "string", "minLength": 1 },
        "billingPeriodStart": { "type": "string", "format": "date-time" },
        "billingPeriodEnd": { "type": "string", "format": "date-time" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/InvoiceLineV1" }
        },
        "subtotal": { "type": "number", "minimum": 0 },
        "sourceBillingRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "PilotGateSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "epoch",
        "warmupStartedAt",
        "pilotStartedAt",
        "lastSafetyFailureAt",
        "resetCount",
        "counters"
      ],
      "properties": {
        "schema": { "const": "PilotGateSnapshotV1" },
        "epoch": { "type": "integer", "minimum": 1 },
        "warmupStartedAt": { "type": "string", "format": "date-time" },
        "pilotStartedAt": { "type": ["string", "null"], "format": "date-time" },
        "lastSafetyFailureAt": { "type": ["string", "null"], "format": "date-time" },
        "resetCount": { "type": "integer", "minimum": 0 },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rotations", "rehomes", "takeovers"],
          "properties": {
            "rotations": { "type": "integer", "minimum": 0 },
            "rehomes": { "type": "integer", "minimum": 0 },
            "takeovers": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "EvidenceManifestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schemaVersion",
        "pilotId",
        "createdAt",
        "publicBundle",
        "simulationOnly",
        "files",
        "gate"
      ],
      "properties": {
        "schema": { "const": "EvidenceManifestV1" },
        "schemaVersion": { "const": "conet.dle.pilot.v1" },
        "pilotId": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "publicBundle": { "const": true },
        "simulationOnly": { "type": "boolean" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 },
              "records": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "gate": { "$ref": "#/$defs/PilotGateSnapshotV1" }
      }
    }
  }
}
